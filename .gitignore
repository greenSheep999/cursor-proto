# ============================================================================
# CRITICAL — never commit
# ============================================================================
# Any real API traffic capture (contains Authorization Bearer tokens)
captures/traffic/
captures/*.har

# Cursor tokens
.cursor-token
*.token
*.cursor-token

# Environment
.env
.env.*

# ============================================================================
# Build artefacts
# ============================================================================
*.pb.go.bak

# Python
__pycache__/
*.py[cod]
*$py.class

# Go
bin/
vendor/

# Compiled CPA plugin shared library and its generated C header.
plugin/cursor/cursor.so
plugin/cursor/cursor.dylib
plugin/cursor/cursor.h
plugin/cursor/cursor.dll

# Same artefacts produced at repo root by ad-hoc local rebuilds
# (`go build -o cursor.dylib ./plugin/cursor`, `go build -o cursor-proxy ./cmd/cursor-proxy`).
/cursor-proxy
/cursor.so
/cursor.dylib
/cursor.dll
/cursor.h

# Local rollback safety copies of the above (mv old new -> .bak-YYYYMMDD).
*.bak-*

# Local one-off diagnostic commands. These are ad-hoc probes used during
# investigation (cache behaviour, /GetMe dumps, SOCKS5 region-gate testing)
# and are not meant to ship as user-facing subcommands. Promote to a
# tracked cmd/* dir intentionally if any of them earns a permanent home.
cmd/test-cache/
cmd/test-getme/
cmd/test-proxy/

# ============================================================================
# Big binary reference material (keep locally, don't push)
# ============================================================================
captures/wb-*.js         # 40 MB Cursor.app JS bundle
captures/wb-*.js.gz

# ============================================================================
# Investigation output — Playwright / screenshot debris left after
# poking at the CPA management panel or other browser flows. Not part
# of the repo; keep locally if useful, but never track.
# ============================================================================
.playwright-mcp/
/*.png

# ============================================================================
# OS junk
# ============================================================================
.DS_Store
*.swp
*.swo
Thumbs.db

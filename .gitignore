# ============================================================================
# CRITICAL — never commit
# ============================================================================
# Any real API traffic capture (contains Authorization Bearer tokens)
captures/traffic/
captures/*.har

# Cursor tokens
.cursor-token
*.token
*.cursor-token
accounts/*.json

# Environment
.env
.env.*

# ============================================================================
# Build artefacts
# ============================================================================
*.pb.go.bak

# Python
__pycache__/
*.py[cod]
*$py.class

# Node.js
node_modules/

# Go
bin/
vendor/

# Compiled CPA plugin shared library and its generated C header.
plugin/cursor/cursor.so
plugin/cursor/cursor.dylib
plugin/cursor/cursor.h
plugin/cursor/cursor.dll

# Same artefacts produced at repo root by ad-hoc local rebuilds
# (`go build -o cursor.dylib ./plugin/cursor`, `go build -o cursor-proxy ./cmd/cursor-proxy`).
/cursor-proxy
/cursor.so
/cursor.dylib
/cursor.dll
/cursor.h

# Local rollback safety copies of the above (mv old new -> .bak-YYYYMMDD).
*.bak-*

# Local one-off diagnostic commands. These are ad-hoc probes used during
# investigation (cache behaviour, /GetMe dumps, SOCKS5 region-gate testing)
# and are not meant to ship as user-facing subcommands. Promote to a
# tracked cmd/* dir intentionally if any of them earns a permanent home.
cmd/test-cache/
cmd/test-getme/
cmd/test-proxy/

# ============================================================================
# Big binary reference material (keep locally, don't push)
# ============================================================================
# ~40 MB Cursor.app JS bundle per version. Note: gitignore has no inline
# comments, so the trailing "# 40 MB ..." that used to sit on this line was
# parsed as part of the pattern and matched nothing — which is how three
# wb-*.js bundles ended up tracked.
captures/wb-*.js
captures/wb-*.js.gz

# ============================================================================
# Investigation output — Playwright / screenshot debris left after
# poking at the CPA management panel or other browser flows. Not part
# of the repo; keep locally if useful, but never track.
# ============================================================================
.playwright-mcp/
/*.png

# ============================================================================
# Phase verification logs. These are one-shot transcripts from manual
# end-to-end runs and embed real account emails plus token metadata, so
# they must never be tracked in a public repo. Keep locally while a phase
# is in flight; the durable record belongs in docs/ or a test.
# ============================================================================
phase-*-verify.log

# Ad-hoc Playwright/CDP login probes driven while reverse-engineering the
# web-session auth flow. They read credentials from the environment and are
# rewritten on every investigation, so they stay local.
.tmp-cursor-*.js

# Local review write-ups (point-in-time audits, not part of the shipped docs).
review/

# ============================================================================
# OS junk
# ============================================================================
.DS_Store
*.swp
*.swo
Thumbs.db
.serena/
